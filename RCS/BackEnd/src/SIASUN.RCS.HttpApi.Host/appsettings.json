{
  "App": {
    "SelfUrl": "http://localhost:9000",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=RCS;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "http://localhost:9000",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "RCS_Swagger",
    "CertificatePassPhrase": "e5353ed4-cb6b-40d6-9488-24af153e1afa"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "IAgjBuA0VJrBRTOJ"
  }}